{
	"name": "@plugdash/import",
	"version": "0.1.0",
	"description": "Move a Ghost or Substack export into a running EmDash site from the command line",
	"keywords": [
		"cli",
		"emdash",
		"ghost",
		"import",
		"substack"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/plugdash/plugdash.git",
		"directory": "packages/import-cli"
	},
	"bin": {
		"plugdash-import": "./dist/cli.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "tsdown src/cli.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint ."
	},
	"dependencies": {
		"@plugdash/fromghost": "workspace:*",
		"@plugdash/fromsubstack": "workspace:*",
		"emdash": ">=0.38.0",
		"fflate": "^0.8.3",
		"linkedom": "^0.18.13",
		"turndown": "^7.2.0",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@types/node": "^20.19.43",
		"@types/turndown": "^5.0.5",
		"vitest": "^2.0.0"
	},
	"engines": {
		"node": ">=20"
	}
}
